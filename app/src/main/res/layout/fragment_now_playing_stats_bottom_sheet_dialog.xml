<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:paddingVertical="16dp">

                <Space
                    android:id="@+id/startToSourceSpace"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/sourceInfoImageView"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Source -->
                <ImageView
                    android:id="@+id/sourceInfoImageView"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_audio_file"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/sourceToTranscodingImageView"
                    app:layout_constraintStart_toEndOf="@+id/startToSourceSpace"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="?attr/colorOnSurface" />

                <ImageView
                    android:id="@+id/sourceToTranscodingImageView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_arrow_forward"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/transcodingInfoImageView"
                    app:layout_constraintStart_toEndOf="@+id/sourceInfoImageView"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="?attr/colorOutline" />

                <!-- Transcoding -->
                <ImageView
                    android:id="@+id/transcodingInfoImageView"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_conversion_path"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/transcodingToDeviceImageView"
                    app:layout_constraintStart_toEndOf="@+id/sourceToTranscodingImageView"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="?attr/colorOnSurface" />

                <ImageView
                    android:id="@+id/transcodingToDeviceImageView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_arrow_forward"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/deviceInfoImageView"
                    app:layout_constraintStart_toEndOf="@+id/transcodingInfoImageView"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="?attr/colorOutline" />

                <!-- Device -->
                <ImageView
                    android:id="@+id/deviceInfoImageView"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_media_output"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/deviceToEndSpace"
                    app:layout_constraintStart_toEndOf="@+id/transcodingToDeviceImageView"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="?attr/colorOnSurface" />

                <Space
                    android:id="@+id/deviceToEndSpace"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/deviceInfoImageView"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <org.lineageos.twelve.ui.views.ListItem
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:headlineText="@string/audio_source"
                app:leadingIconImage="@drawable/ic_audio_file" />

            <org.lineageos.twelve.ui.views.ListItem
                android:id="@+id/sourceFileTypeListItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:headlineText="@string/audio_file_type"
                app:supportingText="@string/audio_file_type_unknown" />

            <org.lineageos.twelve.ui.views.ListItem
                android:id="@+id/sourceEncodingListItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:headlineText="@string/audio_encoding"
                app:supportingText="@string/audio_encoding_unknown" />

            <org.lineageos.twelve.ui.views.ListItem
                android:id="@+id/sourceSampleRateListItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:headlineText="@string/audio_sample_rate"
                app:supportingText="@string/audio_sample_rate_unknown" />

            <org.lineageos.twelve.ui.views.ListItem
                android:id="@+id/sourceChannelCountListItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:headlineText="@string/audio_channel_count"
                app:supportingText="@string/audio_channel_count_unknown" />

            <org.lineageos.twelve.ui.views.ListItem
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:headlineText="@string/audio_transcoding"
                app:leadingIconImage="@drawable/ic_conversion_path" />

            <org.lineageos.twelve.ui.views.ListItem
                android:id="@+id/transcodingOutputModeListItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:headlineText="@string/audio_output_mode"
                app:supportingText="@string/audio_output_mode_unknown" />

            <org.lineageos.twelve.ui.views.ListItem
                android:id="@+id/transcodingEncodingListItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:headlineText="@string/audio_encoding"
                app:supportingText="@string/audio_encoding_unknown" />

            <org.lineageos.twelve.ui.views.ListItem
                android:id="@+id/transcodingBitrateListItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:headlineText="@string/audio_bitrate"
                app:supportingText="@string/audio_bitrate_unknown" />

            <org.lineageos.twelve.ui.views.ListItem
                android:id="@+id/deviceHeaderListItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:headlineText="@string/audio_output"
                app:leadingIconImage="@drawable/ic_media_output" />

            <org.lineageos.twelve.ui.views.ListItem
                android:id="@+id/deviceTypeListItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:headlineText="@string/audio_output_device_type"
                app:supportingText="@string/audio_output_device_type_unknown" />

            <org.lineageos.twelve.ui.views.ListItem
                android:id="@+id/deviceMaxSampleRateListItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:headlineText="@string/audio_sample_rate"
                app:supportingText="@string/audio_sample_rate_unknown" />

            <org.lineageos.twelve.ui.views.ListItem
                android:id="@+id/deviceMaxChannelCountListItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:headlineText="@string/audio_channel_count"
                app:supportingText="@string/audio_channel_count_unknown" />

        </LinearLayout>

    </FrameLayout>

</androidx.core.widget.NestedScrollView>
